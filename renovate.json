{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>mac-lucky/actions-shared-workflows"],
  "packageRules": [
    {
      "matchDepNames": ["vectordotdev/vector"],
      "automerge": false,
      "labels": ["major"]
    },
    {
      "description": "connect-api and connect-sync ship together; the add-on runs one pair of them",
      "matchDepNames": ["1password/connect-api", "1password/connect-sync"],
      "groupName": "1Password Connect"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vector/Dockerfile$/", "/^vector/build\\.yaml$/"],
      "matchStrings": [
        "ARG VECTOR_VERSION=\"(?<currentValue>[0-9.]+)\"",
        "VECTOR_VERSION: \"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "vectordotdev/vector",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "GO_VERSION lives only in build.yaml (the Dockerfile ARG has no default), which no preset manager reads",
      "managerFilePatterns": ["/^ha_gitops_agent/build\\.yaml$/", "/^onepassword_secrets/build\\.yaml$/"],
      "matchStrings": ["GO_VERSION: \"(?<currentValue>[0-9.]+)\""],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "The Connect server binaries in onepassword_secrets are copied out of this image (and connect-sync, same tag); build.yaml passes the tag as CONNECT_VERSION",
      "managerFilePatterns": ["/^onepassword_secrets/build\\.yaml$/"],
      "matchStrings": ["CONNECT_VERSION: \"(?<currentValue>[0-9.]+)\""],
      "datasourceTemplate": "docker",
      "depNameTemplate": "1password/connect-api"
    },
    {
      "customType": "regex",
      "description": "build_from base images. The builder passes them in as BUILD_FROM, so the Dockerfile's ARG default is never what ships",
      "managerFilePatterns": ["/^[^/]+/build\\.yaml$/"],
      "matchStrings": ["(?:amd64|aarch64): (?<depName>[a-z0-9.-]+/[^:\\s]+):(?<currentValue>[^\\s@]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci-gitops-agent\\.yaml$/", "/^\\.github/workflows/ci-onepassword-secrets\\.yaml$/"],
      "matchStrings": ["GITLEAKS_VERSION: \"(?<currentValue>[0-9.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gitleaks/gitleaks",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
