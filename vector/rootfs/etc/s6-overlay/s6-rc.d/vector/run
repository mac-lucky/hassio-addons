#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Vector
# Runs the Vector log collector
# ==============================================================================

declare -a vector_args=()
declare log_level

# shellcheck source=/dev/null
source /usr/lib/vector-common.sh

# Nothing to set up for the credentials here: Vector resolves them at config
# load by running vector-secrets.sh, which reads the options file itself

# Generate configuration from template. The generator also runs `vector
# validate`, on the generated config and on a custom one alike, so this one
# check covers every way the configuration can be wrong. None of them fixes
# itself on a restart; the finish script stops the add-on on this exit code.
if ! /usr/bin/generate-config.sh; then
    bashio::log.fatal "Configuration generation failed!"
    exit "${VECTOR_ADDON_EXIT_FATAL}"
fi

# Get log level from config
log_level=$(bashio::config 'log_level')

# Map HA log levels to Vector log levels
case "${log_level}" in
    trace)
        vector_args+=("--verbose" "--verbose")
        ;;
    debug)
        vector_args+=("--verbose")
        ;;
    info)
        # Default, no extra args
        ;;
    # One --quiet drops Vector to warnings, a second one to errors only
    warning)
        vector_args+=("--quiet")
        ;;
    error)
        vector_args+=("--quiet" "--quiet")
        ;;
esac

# Set config file path (Vector 0.44+ uses --config-yaml)
vector_args+=("--config-yaml" "${VECTOR_CONFIG}")

bashio::log.info "Starting Vector..."
exec vector "${vector_args[@]}"
